# Copy to .env.local and set your own Google AI Studio key. Server-only: do not prefix with VITE_.
GEMINI_API_KEY=
# gemini-1.5-flash has been retired. Set a supported image-input model.
GEMINI_MODEL=gemini-3.8-flash

# Server-only. Add to Vercel Project Settings > Environment Variables.
# Enable Firestore in the Firebase project and use a dedicated service account.
FIREBASE_PROJECT_ID=asset-1d626
FIREBASE_CLIENT_EMAIL=
# Paste the private key into the Vercel secret; escaped \n line breaks are supported.
FIREBASE_PRIVATE_KEY=
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
# For the one-time local admin bootstrap command only. Never commit its value.
ADMIN_BOOTSTRAP_PASSWORD=
