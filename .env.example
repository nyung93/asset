# Copy to .env.local and set your own key. Vite exposes VITE_* values to browsers.
VITE_GEMINI_API_KEY=
# gemini-1.5-flash has been retired. Set a supported image-input model.
VITE_GEMINI_MODEL=gemini-3.8-flash

# Server-only. Add these to Vercel Project Settings > Environment Variables.
# Connect a PostgreSQL database from Vercel Marketplace first.
DATABASE_URL=
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
